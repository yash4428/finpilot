# Copy to .env and adjust. Never commit a real .env.

# --- PostgreSQL ---
DB_NAME=finpilot
DB_USER=finpilot
DB_PASSWORD=finpilot

# --- Java core (Spring Boot) ---
# HMAC key for signing JWTs. Use 32+ random bytes in anything shared.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
# Shared secret for Java -> Python internal calls (X-Internal-Key header).
INTERNAL_API_KEY=dev-internal-key
# Timezone used for "today" when computing dues and forecasts.
TZ=Asia/Kolkata
# Optional: Spring cron for the daily reminder job (default 08:00 every day).
# REMINDER_CRON=0 0 8 * * *

# --- Python ML / agent service ---
# Hosted LLM used as-is through the API (no fine-tuning, no pretraining).
# Leave the keys empty to run the agent with its deterministic offline planner (same tools, same checks).
# Google Gemini (default): create a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is overloaded, before falling back to the offline planner.
LLM_FALLBACK_MODELS=gemini-3-flash-preview,gemini-flash-lite-latest
# Seconds per LLM request.
LLM_TIMEOUT=15
# Anthropic Claude is also supported: set LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY (LLM_MODEL=claude-opus-5-5).
ANTHROPIC_API_KEY=
# auto = use the LLM when a key is set; offline = always use the deterministic planner
AGENT_MODE=auto

# --- Local (non-Docker) service URLs; Docker Compose sets these itself ---
# ML_SERVICE_URL=http://localhost:8000
# JAVA_API_URL=http://localhost:8080
# DATABASE_URL=postgresql://finpilot:finpilot@localhost:5432/finpilot
